{
  "name": "reactiveflutter",
  "version": "1.0.2",
  "description": "Reusable VS Code React JSX/TSX snippets with safe bootstrap installer for macOS.",
  "keywords": [
    "vscode",
    "snippets",
    "react",
    "jsx",
    "tsx",
    "dotfiles"
  ],
  "homepage": "https://github.com/Gracelium64/reactiveFlutter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gracelium64/reactiveFlutter.git"
  },
  "bugs": {
    "url": "https://github.com/Gracelium64/reactiveFlutter/issues"
  },
  "license": "MIT",
  "author": "Gracelium64",
  "type": "commonjs",
  "bin": {
    "vscode-react-snippets": "bin/vscode-react-snippets.js",
    "reactiveflutter": "bin/vscode-react-snippets.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "vscode/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall-message.js",
    "bootstrap": "node ./scripts/bootstrap-vscode.js --mode copy",
    "bootstrap:with-settings": "node ./scripts/bootstrap-vscode.js --mode copy --include-settings",
    "doctor": "node ./scripts/bootstrap-vscode.js --doctor",
    "pack:check": "npm pack --dry-run"
  }
}
